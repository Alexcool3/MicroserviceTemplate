{
  "$schema$": "http://json.schema.schemastore.org/template",
  "author": "Alexander",
  "classifications": ["Web", "Microservice", "API"],
  "identity": "Playground.MicroserviceTemplate.CSharp",
  "name": "Microservice C# Template",
  "shortName": "pg-service",
  "description": "A professional template for Microservice using ASP.NET Core, SharedKernel, Scalar and PostgreSQL.",
  "sourceName": "AuthService",
  "preferNameDirectory": true,
  "symbols": {
    "create-solution": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Automatically creates a Solution (.slnx) file and adds project to it."
    },
    "createSolution": {
      "type": "computed",
      "value": "create-solution"
    },
    "use-ef": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Includes Entity Framework Core and PostgresSQL setup"
    },
    "useEf": {
      "type": "computed",
      "value": "use-ef"
    },
    "use-mapper": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Includes mapper setup using Mapperly."
    },
    "useMapper": {
      "type": "computed",
      "value": "use-mapper"
    },
    "include-gitignore": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Includes custom gitignore file"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".template.config/**",
            ".git/**",
            ".github/**",
            ".vs/**",
            "bin/**",
            "obj/**",
            "**.CSharp.csproj"
          ]
        },
        {
          "exclude": ["**AuthService/Data/**"],
          "condition": "!(useEf)"
        },
        {
          "exclude": ["**AuthService/Mappers/**"],
          "condition": "!(useMapper)"
        },
        {
          "exclude": ["**.slnx"],
          "condition": "!(createSolution)"
        },
        {
          "exclude": ["**.gitignore"],
          "condition": "!(include-gitignore)"
        }
      ]
    }
  ],
  "postActions": [
    {
      "description": "Initialize user-secrets and set Sentry DSN.",
      "manualInstructions": [],
      "evaluator": "msbuild",
      "actionId": "3A69316CD-9A16-4180-8774-4C5C050D6DF1",
      "args": {
        "executable": "dotnet",
        "args": "user-secrets init"
      }
    },
    {
      "description": "Add Sentry DSN to user-secrets.",
      "manualInstructions": [],
      "evaluator": "msbuild",
      "actionId": "3A69316CD-9A16-4180-8774-4C5C050D6DF1",
      "args": {
        "executable": "dotnet",
        "args": "user-secrets set \"Sentry:Dsn\" \"\""
      }
    }
  ]
}
