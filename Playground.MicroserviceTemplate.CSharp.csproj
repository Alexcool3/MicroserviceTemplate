<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageId>Playground.MicroserviceTemplate.CSharp</PackageId>
    <Title>Microservice C# Template</Title>
    <Authors>Alexander</Authors>
    <Description>A professional template for Microservice using ASP.NET Core, SharedKernel, Scalar and PostgreSQL.</Description>
    <PackageTags>dotnet-new;templates;microservice;aspnetcore</PackageTags>
    <TargetFramework>net8.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="**\*" Exclude="bin\**;obj\**;.git\**;.vs\**;*.csporj;*.nupkg" />
  </ItemGroup>

</Project>